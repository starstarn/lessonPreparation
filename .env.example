# 复制为 .env 后填写
# Chat：智谱等；Embedding：可单独走硅基流动 BGE-M3

MOCK_LLM=false

# 教案审核通过后暂停，等老师确认再生成课件/习题/板书（false 关闭闸门）
PLAN_CONFIRM_GATE=true

OPENAI_API_KEY=your-zhipu-api-key
# 本项目优先读 OPENAI_API_BASE；也兼容 OPENAI_BASE_URL
OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

OPENAI_MODEL=glm-4.7-flash

# Embedding（可选独立配置；不填则回退到上面的 OPENAI_*）
EMBEDDING_API_KEY=your-siliconflow-api-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3

# 课件搜图：默认 true=优先搜真图，失败再本地示意图；网络差可改 false
MEDIA_SEARCH_ENABLED=true
UNSPLASH_ACCESS_KEY=
