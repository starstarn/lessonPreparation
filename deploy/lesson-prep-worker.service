[Unit]
Description=Lesson Preparation Worker (Redis queue)
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lessonPreparation
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/lessonPreparation/.env
ExecStart=/opt/lessonPreparation/.venv/bin/python /opt/lessonPreparation/scripts/worker.py
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
